{
  "realm": "pabel",
  "enabled": true,
  "registrationAllowed": false,
  "attributes": {
    "userProfileEnabled": "true"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"abe_attributes\",\"displayName\":\"\",\"validations\":{},\"annotations\":{},\"permissions\":{\"view\":[],\"edit\":[\"admin\"]},\"multivalued\":true}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {"name": "agent_claude_code_user", "description": "May use the claude-code agent"},
      {"name": "agent_opencode_user", "description": "May use the OpenCode agent"},
      {"name": "agent_codex_user", "description": "May use the codex agent"}
    ]
  },
  "clients": [
    {
      "clientId": "pabel",
      "name": "PABEL agent-mediated document access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8766/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "abe_attributes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "abe_attributes",
            "claim.name": "abe_attributes",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pabel-agent-claude-code-0d8c98c3e61224db",
      "name": "dev-machine (demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "{{CLAUDE_CODE_INSTALLATION_SECRET}}"
    },
    {
      "clientId": "pabel-agent-opencode-97361cdc17af2424",
      "name": "charlie's laptop",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "{{OPENCODE_INSTALLATION_SECRET}}"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@org.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{"type": "password", "value": "{{ALICE_PASSWORD}}", "temporary": false}],
      "attributes": {"abe_attributes": ["ceo", "executive", "security"]},
      "realmRoles": ["agent_claude_code_user", "agent_opencode_user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@org.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{"type": "password", "value": "{{BOB_PASSWORD}}", "temporary": false}],
      "attributes": {"abe_attributes": ["hr", "sales", "marketing"]},
      "realmRoles": ["agent_claude_code_user"]
    },
    {
      "username": "charlie",
      "enabled": true,
      "email": "charlie@org.local",
      "emailVerified": true,
      "firstName": "Charlie",
      "lastName": "Demo",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{"type": "password", "value": "{{CHARLIE_PASSWORD}}", "temporary": false}],
      "attributes": {"abe_attributes": ["dev", "risk", "executive"]},
      "realmRoles": ["agent_opencode_user"]
    }
  ]
}