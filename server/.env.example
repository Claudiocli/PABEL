# Copy this file to .env and fill in real values (.env is gitignored).
# Generate strong random values with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Keycloak admin console (compose.yml) ------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Keycloak realm (generate_realm.py -> realm-org.json) -------------------
KEYCLOAK_URL=http://localhost:8080
REALM=pabel
CLIENT_ID=pabel

ALICE_PASSWORD=
BOB_PASSWORD=
CHARLIE_PASSWORD=

# Local loopback port login_with_browser() listens on for Keycloak's
# redirect after login (oauth_browser.py). Only change this if it's
# already in use by something else on your machine.
PABEL_CALLBACK_PORT=8766

# --- PostgreSQL (compose.yml + db.py) ----------------------------------------
POSTGRES_USER=pabel
POSTGRES_PASSWORD=
POSTGRES_DB=pabel
PABEL_DB_DSN=postgresql://pabel:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/pabel

# --- OpenABE CLI (abe.py) ----------------------------------------------------
# Folder containing oabe_setup.exe/oabe_keygen.exe/oabe_enc.exe/oabe_dec.exe
# and their DLLs. Only needed if those aren't already on PATH.
OPENABE_BIN_DIR=

# --- Agent identity (core.resolve_agent) -------------------------------------
# This server instance's own fixed identity - one container/process per
# agent product (see compose.yml: each mcp-server-<agent> service sets its
# own PABEL_AGENT_ID). Not a secret: whether a given user may actually use
# this agent is gated by a Keycloak realm role, not by anything in this
# file. Register the agent first:
#   python agents_admin.py add claude-code "Claude Code" agent_claude_code agent_claude_code_user
# then create the "agent_claude_code_user" realm role in Keycloak and
# assign it to whichever users should be allowed to use this agent.
PABEL_AGENT_ID=
