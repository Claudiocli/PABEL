# Copy this file to .env and fill in real values (.env is gitignored).
# Generate strong random values with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- Keycloak admin console (compose.yml) ------------------------------------
# Also used at runtime by agents_admin.py create-installation/revoke-installation
# (never by mcp_server.py itself - the running server never holds admin-level
# Keycloak credentials, only agents_admin.py, run locally by an admin).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Keycloak realm (generate_realm.py -> realm-org.json) -------------------
KEYCLOAK_URL=http://localhost:8080
REALM=pabel
CLIENT_ID=pabel

ALICE_PASSWORD=alice_secret_pwd
BOB_PASSWORD=bob_secret_pwd
CHARLIE_PASSWORD=charlie_secret_pwd

# One client_secret per agent installation pre-provisioned in the realm
# template. Keycloak runs start-dev here, with its database inside the
# container and no volume, so a removed container loses every client
# agents_admin.py created at runtime - while the agent_installations rows
# in Postgres survive and keep pointing at them. Declaring the demo
# installations in the template instead makes the two stores agree again
# after any restart. Real deployments create installations at runtime and
# have no business putting a client_secret here.
CLAUDE_CODE_INSTALLATION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
OPENCODE_INSTALLATION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Local loopback port login_with_browser() listens on for Keycloak's
# redirect after login (oauth_browser.py). Only change this if it's
# already in use by something else on your machine.
PABEL_CALLBACK_PORT=8766

# --- PostgreSQL (compose.yml + db.py) ----------------------------------------
POSTGRES_USER=pabel
POSTGRES_PASSWORD=pabel
POSTGRES_DB=pabel
PABEL_DB_DSN=postgresql://pabel:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/pabel

# --- OpenABE CLI (abe.py) ----------------------------------------------------
# Folder containing oabe_setup.exe/oabe_keygen.exe/oabe_enc.exe/oabe_dec.exe
# and their DLLs. Only needed if those aren't already on PATH.
OPENABE_BIN_DIR=
