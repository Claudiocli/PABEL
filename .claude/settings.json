{
  "permissions": {
    "allow": [
      "mcp__pabel__whoami",
      "mcp__pabel__read_document"
    ]
  },
  "env": {
    "PABEL_SERVER_URL": "http://localhost:8001/mcp",
    "PABEL_KEYCLOAK_URL": "http://localhost:8080",
    "PABEL_KEYCLOAK_REALM": "pabel",
    "PABEL_KEYCLOAK_CLIENT_ID": "pabel"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/server/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pabel_relay_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find \"/c/Users/claudiol/AppData/Local/Temp/claude/c--Users-claudiol-OneDrive---NTT-DATA-EMEAL-Desktop-Projects-PABEL\" -type f -name 'pabel_scratch_*' -delete 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
